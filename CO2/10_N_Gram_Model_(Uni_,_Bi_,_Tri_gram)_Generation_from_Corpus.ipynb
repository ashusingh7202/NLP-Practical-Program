      "source": [
        "\n",
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "\n",
        "corpus = [\"Natural language processing is very interesting\"]\n",
        "\n",
        "for n in [1, 2, 3]:\n",
        "    vectorizer = CountVectorizer(ngram_range=(n, n))\n",
        "    vectorizer.fit(corpus)\n",
        "    print(f\"{n}-gram:\", vectorizer.get_feature_names_out())\n"
      ],
      "metadata": {
